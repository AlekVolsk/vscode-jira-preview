            "end": "(\\{code\\})",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.tag.block.jira"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "entity.name.tag.block.jira"
                }
            },
            "contentName": "markup.raw.block.jira"
