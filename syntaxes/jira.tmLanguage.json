            "match": "\\\\[\\\\{}\\[\\]*_+^~?!|-]",
            "name": "constant.character.escape.jira"
        },
        "monospace": {
            "match": "(\\{\\{)(.*?)(\\}\\})",
            "captures": {
                "1": {
                    "name": "punctuation.definition.raw.jira"
                },
                "2": {
                    "name": "markup.inline.raw.jira"
