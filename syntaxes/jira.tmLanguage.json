                        },
                        "2": {
                            "name": "variable.parameter.jira"
                        },
                        "3": {
                            "name": "entity.name.tag.jira"
                        }
                    }
                },
                {
                    "match": "\\{\\}",
                    "name": "comment.jira"
                }
            ]
